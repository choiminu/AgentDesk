{
  "name": "agentdesk",
  "version": "0.1.0",
  "description": "AgentDesk — a pixel-art office for your AI coding agents",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "dist": "electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.agentdesk.app",
    "productName": "AgentDesk",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "dmg": {
      "title": "AgentDesk",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.mjs",
      "widget.html",
      "preload.cjs",
      "package.json",
      "assets/**/*"
    ]
  }
}
