{
  "name": "agentdesk",
  "version": "0.2.2",
  "description": "AgentDesk — a pixel-art office for your AI coding agents",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "postinstall": "node scripts/dev-localnet.mjs",
    "dist": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:all": "electron-builder -mwl --publish never",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.agentdesk.app",
    "productName": "AgentDesk",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "팀 공유를 켜면 사무실 네트워크에 있는 팀원 PC에 접속해 팀원의 에이전트 세션 상태를 가져옵니다. 이 권한이 없으면 팀원 세션이 보이지 않습니다."
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "AgentDesk",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 400,
          "type": "file",
          "path": "build/dmg/처음 실행.command"
        }
      ],
      "window": {
        "width": 540,
        "height": 520
      }
    },
    "files": [
      "main.mjs",
      "jira-oauth.mjs",
      "widget.html",
      "preload.cjs",
      "core/**/*",
      "diff/**/*",
      "team/**/*",
      "perm/**/*",
      "guard/**/*",
      "package.json",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "choiminu",
      "icon": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/choiminu/AgentDesk.git"
  },
  "author": "choiminu",
  "license": "MIT",
  "homepage": "https://github.com/choiminu/AgentDesk",
  "allowScripts": {
    "electron@36.9.5": true
  }
}
